# ===========================
# MouseScope — .gitignore
# ===========================

# PyInstaller build artifacts
build/
dist/

# User data (never commit experimental data, local DBs, uploaded videos, and secrets)
data/
*.sqlite
*.sqlite3
*.db

# Local docs, planning notes, and release drafts
/*.md
!/README.md
docs/**/*.md

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.suo
*.user

# Logs
*.log

# Temporary files
*.tmp
*.bak
backup/
backups/
result/

# Video files (use GIF for demos)
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.wmv
*.mpg
*.mpeg
*.mp4 

# Root-level scratch screenshots/covers
/*.png

# Local promotion drafts and generated social-media assets
promo/
