# ===========================
# MouseScope — .gitignore
# ===========================

# PyInstaller build artifacts
build/
dist/

# User data (never commit experimental data, local DBs, uploaded videos, and secrets)
data/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.suo
*.user

# Logs
*.log

# Temporary files
*.tmp
*.bak
backup/
backups/
result/

# Video files (use GIF for demos)
*.mp4
*.avi
*.mov
*.mkv
*.mp4 

# Root-level scratch screenshots/covers
/*.png
